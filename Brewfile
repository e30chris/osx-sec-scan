# Scanners (CLI)
brew "clamav"   # GPL-2.0  - signature malware scanner
brew "yara"     # BSD-3    - pattern matching for malware families
brew "lynis"    # GPL-3.0  - host security audit
cask "osquery"  # Apache-2.0 / GPL-2.0 - SQL over OS state

# Objective-See tools (all GPL-3.0, github.com/objective-see)
cask "knockknock" # persistence enumeration (also used by the scanner)
cask "lulu"       # outbound firewall
cask "blockblock" # persistence install alerts
cask "reikey"     # keyboard event tap (keylogger) alerts
cask "oversight"  # mic / camera use alerts
